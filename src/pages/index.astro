---
import database from "../data/lenses.json";
import FilterPanel from "../components/FilterPanel.astro";
import FocalMap from "../components/FocalMap.astro";
import Header from "../components/Header.astro";
import LensRow from "../components/LensRow.astro";
import LensTable from "../components/LensTable.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { byFocal, equivalentRange } from "../lib/lens-math";
import type { LensDatabase } from "../types/lens";

const { lenses, featureDefinitions } = database as LensDatabase;
const initialLenses = [...lenses].sort(byFocal);
const equivalents = lenses.map(equivalentRange);
const weights = lenses.map((lens) => lens.weight);
const stats = [
  { value: String(lenses.length), label: "支鏡頭" },
  { value: `${Math.min(...equivalents.map((range) => range.min))}–${Math.max(...equivalents.map((range) => range.max))}`, label: "mm 等效焦段" },
  { value: `${Math.min(...weights)}–${Math.max(...weights).toLocaleString("en-US")}`, label: "g 重量" },
];
const sortOptions = [
  ["focal-asc", "焦距 短→長"], ["focal-desc", "焦距 長→短"],
  ["aperture-asc", "光圈 亮→暗"], ["aperture-desc", "光圈 暗→亮"],
  ["weight-asc", "重量 輕→重"], ["weight-desc", "重量 重→輕"],
  ["magnification-desc", "放大倍率 高→低"], ["magnification-asc", "放大倍率 低→高"],
];
const description = "整理 Fujifilm XF、XC、GF 原廠鏡頭規格，提供 35mm 等效焦距、光圈、重量、OIS、WR、LM 等條件篩選與鏡頭比較。";
---

<BaseLayout title="Fujifilm Lens Database｜富士 XF、XC、GF 鏡頭規格整理" description={description} socialImage={`${import.meta.env.BASE_URL}og.png`}>
  <Header catalog />
  <main class="page-shell">
    <section class="intro" aria-labelledby="page-title">
      <div>
        <h1 id="page-title">富士原廠鏡頭規格庫</h1>
        <p>XF、XC、GF 全系列規格。搜尋、篩選、比較，不談價格。</p>
      </div>
      <dl class="intro-stats">
        {stats.map(({ value, label }) => <div><dt>{label}</dt><dd class="num">{value}</dd></div>)}
      </dl>
    </section>

    <FocalMap lenses={lenses} />

    <div class="catalog-layout">
      <aside class="filters" aria-label="鏡頭篩選"><FilterPanel featureDefinitions={featureDefinitions} /></aside>

      <section class="catalog-results" aria-labelledby="results-title" data-results data-view="list">
        <div class="results-head">
          <h2 id="results-title" aria-live="polite"><span class="num" data-results-count>{lenses.length}</span> 支鏡頭</h2>
          <div class="result-controls">
            <label class="switch"><input type="checkbox" data-equivalent-toggle /> 等效焦距</label>
            <label class="sort-control"><span class="sr-only">排序</span>
              <select data-sort>{sortOptions.map(([value, label]) => <option value={value}>{label}</option>)}</select>
            </label>
            <div class="segmented view-switch" role="group" aria-label="顯示方式">
              <button type="button" data-view-button="list" aria-pressed="true">清單</button>
              <button type="button" data-view-button="table" aria-pressed="false">表格</button>
            </div>
          </div>
        </div>
        <div class="active-filters" data-active-filters></div>

        <div class="lens-list" data-lens-list>
          {initialLenses.map((lens) => <LensRow lens={lens} featureDefinitions={featureDefinitions} />)}
        </div>
        <LensTable lenses={initialLenses} featureDefinitions={featureDefinitions} />
        <div class="empty-state" data-empty-state hidden>
          <h3>沒有符合條件的鏡頭</h3>
          <p data-empty-hint>試著放寬其中一個條件：</p>
          <div class="chips empty-suggestions" data-empty-suggestions></div>
          <button type="button" class="secondary-button" data-reset-all>清除搜尋與全部篩選</button>
        </div>
      </section>
    </div>

    <section class="about" id="about" aria-labelledby="about-title">
      <h2 id="about-title">關於這個資料庫</h2>
      <p>FujiLens 只整理 Fujifilm 原廠 XF、XC 與 GF 鏡頭，以焦距、光圈、重量與鏡頭功能為核心，讓規格查找保持快速而純粹。</p>
      <p>等效焦距以 X 系統 ×1.5、GFX 系統 ×0.79 換算，四捨五入至整數，方便跨系統比較視角。</p>
    </section>
  </main>
  <footer class="site-footer"><span>FUJILENS</span><span>{lenses.length} 支 Fujinon 原廠鏡頭</span></footer>

  <dialog class="filter-drawer" id="filter-drawer" aria-labelledby="filter-drawer-title" data-filter-drawer>
    <div class="drawer-header">
      <h2 id="filter-drawer-title">篩選</h2>
      <button type="button" class="drawer-close" data-close-filters aria-label="關閉篩選">×</button>
    </div>
    <div class="drawer-body"><FilterPanel featureDefinitions={featureDefinitions} mobile /></div>
    <div class="drawer-footer"><button type="button" class="primary-button" data-close-filters>顯示 <span data-results-count>{lenses.length}</span> 支鏡頭</button></div>
  </dialog>
  <script>import "../scripts/catalog";</script>
</BaseLayout>
