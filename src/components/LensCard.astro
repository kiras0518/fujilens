---
import FeatureBadge from "./FeatureBadge.astro";
import { formatAperture, formatFilter, formatFocalLength, formatMagnification } from "../lib/format";
import type { FeatureDefinition, Lens } from "../types/lens";
interface Props { lens: Lens; featureDefinitions: Record<string, FeatureDefinition> }
const { lens, featureDefinitions } = Astro.props;
const searchText = [lens.name, lens.series, lens.mount === "X" ? "X Mount" : "G Mount", lens.type, formatFocalLength(lens), formatAperture(lens), ...lens.features.flatMap((code) => [code, featureDefinitions[code]?.name, featureDefinitions[code]?.nameZh])].filter(Boolean).join(" ").toLocaleLowerCase("en");
const detailUrl = `${import.meta.env.BASE_URL}lenses/${lens.id}/`;
---

<article class="lens-card" data-lens-id={lens.id} data-search={searchText} data-mount={lens.mount} data-series={lens.series} data-type={lens.type} data-features={lens.features.join("|")} data-focal-min={lens.focalLength.min} data-focal-max={lens.focalLength.max} data-aperture={lens.aperture.maxWide} data-weight={lens.weight} data-magnification={lens.maxMagnification ?? ""}>
  <div class="card-top"><span class="series-chip">{lens.series}</span><span class="type-label">{lens.type === "prime" ? "PRIME · 定焦" : "ZOOM · 變焦"}</span></div>
  <h3><a href={detailUrl}>{lens.name}</a></h3>
  <dl class="card-specs">
    <div><dt>FOCAL</dt><dd>{formatFocalLength(lens)}</dd></div>
    <div><dt>APERTURE</dt><dd>{formatAperture(lens)}</dd></div>
    <div><dt>WEIGHT</dt><dd>{lens.weight}g</dd></div>
    <div><dt>FILTER</dt><dd>{formatFilter(lens.filterSize)}</dd></div>
    <div><dt>OPTICS</dt><dd>{lens.opticalConstruction.groups}群{lens.opticalConstruction.elements}枚</dd></div>
    <div><dt>MAG.</dt><dd>{formatMagnification(lens.maxMagnification)}</dd></div>
  </dl>
  <div class="feature-row">{lens.features.map((code) => <FeatureBadge code={code} definition={featureDefinitions[code]} />)}</div>
  <a class="details-link" href={detailUrl}>VIEW DETAILS <span aria-hidden="true">↗</span></a>
</article>
