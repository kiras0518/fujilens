---
import FeatureBadge from "./FeatureBadge.astro";
import { formatAperture, formatFilter, formatFocalLength, formatMagnification } from "../lib/format";
import type { FeatureDefinition, Lens } from "../types/lens";
interface Props { lenses: Lens[]; featureDefinitions: Record<string, FeatureDefinition> }
const { lenses, featureDefinitions } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="table-wrap" data-table-wrap hidden>
  <table class="lens-table">
    <thead><tr><th scope="col">Lens</th><th scope="col">Focal length</th><th scope="col">Aperture</th><th scope="col">Optics</th><th scope="col">Blades</th><th scope="col">Magnification</th><th scope="col">Filter</th><th scope="col">Weight</th><th scope="col">Features</th></tr></thead>
    <tbody data-table-body>
      {lenses.map((lens) => (
        <tr data-lens-id={lens.id}>
          <th scope="row"><a href={`${base}lenses/${lens.id}/`}>{lens.name}</a></th>
          <td>{formatFocalLength(lens)}</td><td>{formatAperture(lens)}</td>
          <td>{lens.opticalConstruction.groups}群{lens.opticalConstruction.elements}枚</td><td>{lens.apertureBlades}</td>
          <td>{formatMagnification(lens.maxMagnification)}</td><td>{formatFilter(lens.filterSize)}</td><td>{lens.weight}g</td>
          <td><div class="table-features">{lens.features.map((code) => <FeatureBadge code={code} definition={featureDefinitions[code]} compact />)}</div></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
