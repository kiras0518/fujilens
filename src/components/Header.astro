---
interface Props {
  /** On the catalog page the search filters live and the mobile filter button is shown. */
  catalog?: boolean;
}

const { catalog = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <a class="brand" href={base} aria-label="FujiLens 首頁">
    <span class="brand-mark" aria-hidden="true"></span>
    <span>FUJILENS</span>
  </a>
  <form class="search-box" action={base} method="get" role="search" data-search-form>
    <span class="search-symbol" aria-hidden="true">⌕</span>
    <label class="sr-only" for="lens-search">搜尋鏡頭</label>
    <input id="lens-search" name="q" type="search" placeholder="搜尋 35mm、F1.4、WR、微距…" autocomplete="off" data-search />
    <button type="button" class="clear-search" aria-label="清除搜尋" data-clear-search hidden>×</button>
    <kbd aria-hidden="true">/</kbd>
  </form>
  <div class="header-actions">
    {catalog && (
      <button type="button" class="icon-button filter-trigger" data-open-filters aria-haspopup="dialog" aria-controls="filter-drawer">
        篩選 <span class="badge" data-active-filter-count hidden></span>
      </button>
    )}
    <a class="icon-button" href={`${base}compare/`} data-compare-link>
      比較 <span class="badge" data-compare-count hidden>0</span>
    </a>
    <button type="button" class="icon-button theme-toggle" data-theme-toggle aria-label="切換深淺色模式">
      <span aria-hidden="true">◐</span>
    </button>
  </div>
</header>
